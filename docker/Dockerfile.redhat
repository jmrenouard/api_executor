# Multi-stage Dockerfile for testing RedHat / UBI9 predefined OS tasks
FROM golang:1.24-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -a -ldflags="-w -s" -o /go-admin-tool ./cmd/server

FROM redhat/ubi9:latest
RUN dnf install -y --nodocs \
    procps-ng \
    iproute \
    && dnf clean all

WORKDIR /app
RUN groupadd -r appgroup && useradd -r -g appgroup appuser
COPY --from=builder /go-admin-tool /app/go-admin-tool
COPY configs/redhat-tasks.yaml /app/config.yaml
COPY --chown=appuser:appgroup plugins /app/plugins
COPY --chown=appuser:appgroup web /app/web
RUN mkdir -p /var/log/secure_files /app/certs && chown -R appuser:appgroup /var/log/secure_files /app

USER appuser
EXPOSE 8080
ENTRYPOINT ["/app/go-admin-tool"]
