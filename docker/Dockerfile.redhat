# Multi-stage Dockerfile for testing RedHat / UBI9 predefined OS tasks
FROM golang:1.24-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -a -ldflags="-w -s" -o /go-admin-tool ./cmd/server

FROM redhat/ubi9:latest
RUN dnf install -y --nodocs \
    ca-certificates \
    curl-minimal \
    procps-ng \
    iproute \
    && dnf clean all

WORKDIR /app
RUN groupadd -g 10001 -r appgroup && useradd -u 10001 -r -g appgroup -s /sbin/nologin -d /app appuser
COPY --chown=10001:10001 --from=builder /go-admin-tool /app/go-admin-tool
COPY --chown=10001:10001 configs/redhat-tasks.yaml /app/config.yaml
COPY --chown=10001:10001 plugins /app/plugins
COPY --chown=10001:10001 web /app/web
RUN mkdir -p /var/log/secure_files /app/certs /app/data && chown -R appuser:appgroup /var/log/secure_files /app

USER 10001:10001
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -k -f https://127.0.0.1:8080/metrics > /dev/null || exit 1
ENTRYPOINT ["/app/go-admin-tool"]
