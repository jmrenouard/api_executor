                },
                "workers_active": {
                    "type": "integer"
                },
                "workers_total": {
                    "type": "integer"
                }
            },
            "type": "object"
        },
        "api.SubmitJobRequest": {
            "properties": {
                "action": {
                    "description": "Command name or plugin action to execute",
                    "type": "string"
                },
                "params": {
                    "description": "Input parameters for command or plugin action",
                    "type": "object"
                },
                "plugin_id": {
                    "description": "Target plugin identifier if type is 'plugin'",
                    "type": "string"
                },
                "priority": {
                    "description": "Execution priority tier ('high', 'normal', 'low')",
                    "enum": [
                        "high",
                        "normal",
                        "low"
                    ],
                    "type": "string"
                },
                "timeout": {
                    "description": "Optional per-job timeout override (e.g. '30s', '5m', '10')",
                    "type": "string"
                },
                "timeout_override": {
                    "description": "Optional alias for per-job timeout override",
                    "type": "string"
                },
                "type": {
                    "description": "Execution mechanism ('command' or 'plugin')",
                    "enum": [
                        "command",
                        "plugin"
                    ],
                    "type": "string"
                }
            },
            "required": [
