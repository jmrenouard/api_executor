{
    "swagger": "2.0",
    "info": {
        "contact": {
            "email": "support@swagger.io",
            "name": "API Support",
            "url": "http://www.swagger.io/support"
        },
        "description": "This is a lightweight remote administration tool.",
        "license": {
            "name": "Apache 2.0",
            "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
        },
        "termsOfService": "http://swagger.io/terms/",
        "title": "Go Admin Tool API",
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/api/v1/commands": {
            "get": {
                "description": "Retrieves a list of commands that are available to be executed, along with their effective timeouts.",
                "produces": [
                    "application/json"
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/core.ExecutorConfig"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                },
                "summary": "List available commands",
                "tags": [
                    "commands"
                ]
            }
        },
        "/api/v1/execute": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "description": "Executes a command predefined in the server's configuration, with optional per-call timeout override.",
                "parameters": [
                    {
                        "description": "Command to execute (with optional timeout override)",
                        "in": "body",
                        "name": "command",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/api.ExecuteCommandRequest"
                        }
                    },
                    {
                        "description": "Optional timeout override (e.g., 10s, 500ms, or seconds)",
                        "in": "query",
                        "name": "timeout",
                        "type": "string"
                    },
                    {
                        "description": "Optional timeout override in seconds",
                        "in": "query",
                        "name": "timeout_seconds",
                        "type": "number"
                    },
                    {
                        "description": "Optional timeout override in milliseconds",
                        "in": "query",
                        "name": "timeout_ms",
                        "type": "integer"
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.ExecuteCommandResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                },
                "summary": "Execute a predefined command",
                "tags": [
                    "commands"
                ]
            }
        },
        "/api/v1/jobs": {
            "get": {
                "description": "Retrieves a paginated list of active and historical background jobs with optional status, type, action, and actor filtering.",
                "parameters": [
                    {
                        "description": "Filter by job status (queued, running, completed, failed, cancelled, timed_out)",
                        "in": "query",
                        "name": "status",
                        "type": "string"
                    },
                    {
                        "description": "Filter by job type (command, plugin)",
                        "in": "query",
                        "name": "type",
                        "type": "string"
                    },
                    {
                        "description": "Filter by action or command name",
                        "in": "query",
                        "name": "action",
                        "type": "string"
                    },
                    {
                        "description": "Filter by submitting actor ID",
                        "in": "query",
                        "name": "actor_id",
                        "type": "string"
                    },
                    {
                        "description": "Maximum number of jobs to return (default 50, max 200)",
                        "in": "query",
                        "name": "limit",
                        "type": "integer"
                    },
                    {
                        "description": "Pagination offset (default 0)",
                        "in": "query",
                        "name": "offset",
                        "type": "integer"
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.JobListResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                },
                "summary": "List asynchronous background jobs",
                "tags": [
                    "jobs"
                ]
            },
            "post": {
                "consumes": [
                    "application/json"
                ],
                "description": "Enqueues a command or plugin action for non-blocking asynchronous execution with configurable priority, timeout override, and input parameters. Returns HTTP 202 Accepted.",
                "parameters": [
                    {
                        "description": "Background job submission payload",
                        "in": "body",
                        "name": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/api.SubmitJobRequest"
                        }
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "responses": {
                    "202": {
                        "description": "Accepted",
                        "headers": {
                            "Location": {
                                "description": "URI of the created job resource",
                                "type": "string"
                            }
                        },
                        "schema": {
                            "$ref": "#/definitions/api.SubmitJobResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "429": {
                        "description": "Too Many Requests (Queue capacity exceeded)",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                },
                "summary": "Submit a background job",
                "tags": [
                    "jobs"
                ]
            }
        },
        "/api/v1/jobs/queue": {
            "get": {
                "description": "Returns real-time metrics on asynchronous job queue depth, worker pool concurrency, active workers, and capacity.",
                "produces": [
                    "application/json"
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.QueueStatsResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                },
                "summary": "Get queue depth and worker telemetry",
                "tags": [
                    "jobs"
                ]
            }
        },
        "/api/v1/jobs/{id}": {
            "get": {
                "description": "Retrieves complete metadata, execution timestamps, duration, and terminal status for a specific background job.",
                "parameters": [
                    {
                        "description": "Unique Job Identifier (e.g. job_...)",
                        "in": "path",
                        "name": "id",
                        "required": true,
                        "type": "string"
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/jobs.Job"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                },
                "summary": "Get job details by ID",
                "tags": [
                    "jobs"
                ]
            }
        },
        "/api/v1/jobs/{id}/cancel": {
            "post": {
                "description": "Aborts an active background job. Queued jobs are immediately cancelled; running jobs receive an OS process-group kill signal.",
                "parameters": [
                    {
                        "description": "Unique Job Identifier",
                        "in": "path",
                        "name": "id",
                        "required": true,
                        "type": "string"
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.CancelJobResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Conflict (Job already finished)",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                },
                "summary": "Cancel a queued or running job",
                "tags": [
                    "jobs"
                ]
            }
        },
        "/api/v1/jobs/{id}/logs": {
            "get": {
                "description": "Streams live captured stdout and stderr log chunks from the job execution buffer starting from a byte offset, returning next_offset and EOF status.",
                "parameters": [
                    {
                        "description": "Unique Job Identifier",
                        "in": "path",
                        "name": "id",
                        "required": true,
                        "type": "string"
                    },
                    {
                        "description": "Starting byte offset for log chunk reading (default 0)",
                        "in": "query",
                        "name": "offset",
                        "type": "integer"
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.JobLogsResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                },
                "summary": "Stream live chunked job logs",
                "tags": [
                    "jobs"
                ]
            }
        },
        "/api/v1/files": {
            "get": {
                "description": "Retrieves a list of files available for download from the configured secure directory.",
                "produces": [
                    "application/json"
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.FileListResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                },
                "summary": "List files in the secure directory",
                "tags": [
                    "files"
                ]
            }
        },
        "/api/v1/files/{filename}": {
            "get": {
                "description": "Downloads a specific file from the configured secure directory.",
                "parameters": [
                    {
                        "description": "Filename to download",
                        "in": "path",
                        "name": "filename",
                        "required": true,
                        "type": "string"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "file"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                },
                "summary": "Download a file from the secure directory",
                "tags": [
                    "files"
                ]
            }
        }
    },
    "definitions": {
        "api.CancelJobResponse": {
            "properties": {
                "job_id": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            },
            "type": "object"
        },
        "api.ErrorResponse": {
            "properties": {
                "error": {
                    "type": "string"
                }
            },
            "type": "object"
        },
        "api.ExecuteCommandRequest": {
            "properties": {
                "name": {
                    "type": "string"
                },
                "timeout": {
                    "description": "Optional per-call timeout override (e.g., 10s, 500ms, or seconds)",
                    "type": "string"
                },
                "timeout_ms": {
                    "description": "Optional per-call timeout override in milliseconds",
                    "type": "integer"
                },
                "timeout_seconds": {
                    "description": "Optional per-call timeout override in seconds",
                    "type": "number"
                }
